<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_close"
            android:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/title_collage"
            style="@style/TopBarTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/compositing"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_export"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            style="@style/Widget.Material3.Button.TonalButton" />
    </LinearLayout>

    <!-- 主体：左侧导航 + 中间画布 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左侧：模式导航 + 列表容器 -->
        <LinearLayout
            android:layout_width="@dimen/mode_rail_width"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:orientation="vertical"
            android:elevation="1dp">

            <LinearLayout
                android:id="@+id/modeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="10dp"
                android:clipToPadding="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="4dp"
                android:background="?attr/colorOutlineVariant" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/leftListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="6dp" />
            </ScrollView>
        </LinearLayout>

        <!-- 中间：画布区 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/canvas_bg">

            <com.example.collage.FreeCanvasView
                android:id="@+id/canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <GridView
                android:id="@+id/gridView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="auto_fit"
                android:gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 底部面板：全局工具行 + 上下文面板（操作/排列/属性） + 精修条 -->
    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surfaceContainerLow"
        android:elevation="2dp">

        <!-- 全局工具行（常显） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdd"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/add_image"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_add_photo"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                style="@style/Widget.Material3.Button" />

            <ImageButton
                android:id="@+id/btnRandom"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/random_layout"
                android:src="@drawable/ic_shuffle"
                android:tint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSegmentAll"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="@string/segment_all"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:backgroundTint="?attr/colorTertiaryContainer"
                android:textColor="?attr/colorOnTertiaryContainer"
                app:icon="@drawable/ic_person"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="?attr/colorOnTertiaryContainer"
                style="@style/Widget.Material3.Button.TonalButton" />

            <ImageButton
                android:id="@+id/btnBoard"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/board_settings"
                android:src="@drawable/ic_palette"
                android:tint="?attr/colorOnSurfaceVariant" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/zoom"
                style="@style/PropLabel" />

            <com.google.android.material.slider.Slider
                android:id="@+id/seekZoom"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:valueFrom="30"
                android:valueTo="300"
                android:stepSize="5"
                android:value="100" />
        </LinearLayout>

        <!-- 选中元素提示标题 -->
        <TextView
            android:id="@+id/tvPanelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:paddingStart="16dp"
            android:text="@string/img_settings"
            style="@style/PropSectionTitle" />

        <TextView
            android:id="@+id/tvNoSelection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:text="@string/no_selection"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 上下文面板（选中元素时显示）：Tab 操作 / 排列 / 属性 -->
        <LinearLayout
            android:id="@+id/propContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabProps"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabIndicatorFullWidth="false"
                app:tabTextAppearance="@style/TabLabel" />

            <ViewFlipper
                android:id="@+id/flipperProps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 页 1：操作 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/btnReplace"
                            style="@style/ToolCell"
                            android:layout_weight="1">
                            <ImageView style="@style/ToolCellIcon"
                                android:contentDescription="@string/replace"
                                android:src="@drawable/ic_replace"/>
                            <TextView style="@style/ToolCellLabel"
                                android:text="@string/replace"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnCrop"
                            style="@style/ToolCell"
                            android:layout_weight="1">
                            <ImageView style="@style/ToolCellIcon"
                                android:contentDescription="@string/crop"
                                android:src="@drawable/ic_crop"/>
                            <TextView style="@style/ToolCellLabel"
                                android:text="@string/crop"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnFilter"
                            style="@style/ToolCell"
                            android:layout_weight="1">
                            <ImageView style="@style/ToolCellIcon"
                                android:contentDescription="@string/filter"
                                android:src="@drawable/ic_tune"/>
                            <TextView style="@style/ToolCellLabel"
                                android:text="@string/filter"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/btnMask"
                            style="@style/ToolCell"
                            android:layout_weight="1">
                            <ImageView style="@style/ToolCellIcon"
                                android:contentDescription="@string/mask"
                                android:src="@drawable/ic_mask"/>
                            <TextView style="@style/ToolCellLabel"
                                android:text="@string/mask"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnSegment"
                            style="@style/ToolCell"
                            android:layout_weight="1">
                            <ImageView style="@style/ToolCellIcon"
                                android:contentDescription="@string/segment_person"
                                android:src="@drawable/ic_person"/>
                            <TextView style="@style/ToolCellLabel"
                                android:text="@string/segment_person"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnRefine"
                            style="@style/ToolCell"
                            android:layout_weight="1">
                            <ImageView style="@style/ToolCellIcon"
                                android:contentDescription="@string/refine_mask"
                                android:src="@drawable/ic_edit"/>
                            <TextView style="@style/ToolCellLabel"
                                android:text="@string/refine_mask"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 页 2：排列 -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAlignLeft"
                                android:text="@string/align_left"
                                style="@style/ArrangeChip"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAlignCenterH"
                                android:layout_marginStart="6dp"
                                android:text="@string/align_center_h"
                                style="@style/ArrangeChip"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAlignRight"
                                android:layout_marginStart="6dp"
                                android:text="@string/align_right"
                                style="@style/ArrangeChip"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAlignTop"
                                android:layout_marginStart="6dp"
                                android:text="@string/align_top"
                                style="@style/ArrangeChip"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAlignCenterV"
                                android:layout_marginStart="6dp"
                                android:text="@string/align_center_v"
                                style="@style/ArrangeChip"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAlignBottom"
                                android:layout_marginStart="6dp"
                                android:text="@string/align_bottom"
                                style="@style/ArrangeChip"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDistributeH"
                                android:text="@string/distribute_h"
                                style="@style/ArrangeChip"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDistributeV"
                                android:layout_marginStart="6dp"
                                android:text="@string/distribute_v"
                                style="@style/ArrangeChip"/>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="10dp"
                                android:layout_gravity="center_vertical"
                                android:background="?attr/colorOutlineVariant"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLayerFront"
                                android:text="@string/layer_front"
                                style="@style/ArrangeChip"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLayerBack"
                                android:layout_marginStart="6dp"
                                android:text="@string/layer_back"
                                style="@style/ArrangeChip"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLayerUp"
                                android:text="@string/layer_up"
                                style="@style/ArrangeChip"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLayerDown"
                                android:layout_marginStart="6dp"
                                android:text="@string/layer_down"
                                style="@style/ArrangeChip"/>
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- 页 3：属性 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:text="@string/opacity"
                            style="@style/PropLabel"/>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/seekOpacity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:valueFrom="0"
                            android:valueTo="100"
                            android:stepSize="1"
                            android:value="100"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:text="@string/lock"
                            style="@style/PropLabel"/>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/toggleLock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textOn="@string/locked"
                            android:textOff="@string/unlock"/>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDelete"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="@string/del"
                            android:textSize="12sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:textColor="?attr/colorOnErrorContainer"
                            app:backgroundTint="?attr/colorErrorContainer"
                            app:icon="@drawable/ic_delete"
                            app:iconGravity="textStart"
                            app:iconPadding="4dp"
                            app:iconTint="?attr/colorOnErrorContainer"
                            style="@style/Widget.Material3.Button.ElevatedButton"/>
                    </LinearLayout>
                </LinearLayout>
            </ViewFlipper>
        </LinearLayout>

        <!-- 手动修正：笔刷大小（修正态显示） -->
        <LinearLayout
            android:id="@+id/brushSizeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="@string/brush_size"
                style="@style/PropLabel"/>

            <com.google.android.material.slider.Slider
                android:id="@+id/seekBrush"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="4"
                android:valueTo="120"
                android:stepSize="1"
                android:value="30"/>
        </LinearLayout>

        <!-- 手动修正：工具条（修正态显示） -->
        <LinearLayout
            android:id="@+id/refineToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/brushToggle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnErase"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/erase"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_erase"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPaint"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/paint"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_brush"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearMask"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="@string/clear_mask"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                style="@style/Widget.Material3.Button.TextButton"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDoneMask"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/done"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                style="@style/Widget.Material3.Button"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
