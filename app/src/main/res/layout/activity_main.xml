<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F3F5"
    android:fitsSystemWindows="true">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#212121" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/title_collage"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/compositing"
            android:textSize="13sp"
            android:backgroundTint="#3F51B5"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- 主体：左侧导航 + 中间画布（整行横向，画布占满宽度） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左侧：模式导航 + 列表容器 -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:elevation="1dp">

            <LinearLayout
                android:id="@+id/modeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:clipToPadding="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:background="#EEEEEE" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/leftListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="6dp" />
            </ScrollView>
        </LinearLayout>

        <!-- 中间：画布区（占满剩余宽度，不再被右侧栏挤压） -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#E9EAEC">

            <com.example.collage.FreeCanvasView
                android:id="@+id/canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <GridView
                android:id="@+id/gridView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="auto_fit"
                android:gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 下方：图片设置面板（横向分组排布，整体矮，宽度超出时横向滚动） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="170dp"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:scrollbars="horizontal">

        <LinearLayout
            android:id="@+id/rightPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvPanelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="@string/img_settings"
                style="@style/PropSectionTitle" />

            <TextView
                android:id="@+id/tvNoSelection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="@string/no_selection"
                android:textColor="#9AA0A6"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- 组：画板设置（背景色 + 尺寸，常显） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/board_settings"
                    style="@style/PropSectionTitle" />

                <LinearLayout
                    android:id="@+id/bgColorRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:id="@+id/sizeRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:background="#EEEEEE" />

            <LinearLayout
                android:id="@+id/propContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <!-- 组：操作 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="12dp"
                    android:paddingStart="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnReplace"
                            android:layout_width="72dp"
                            android:layout_height="34dp"
                            android:text="@string/replace"
                            android:textSize="11sp"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnCrop"
                            android:layout_width="72dp"
                            android:layout_height="34dp"
                            android:text="@string/crop"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <Button
                            android:id="@+id/btnFilter"
                            android:layout_width="72dp"
                            android:layout_height="34dp"
                            android:text="@string/filter"
                            android:textSize="11sp"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnMask"
                            android:layout_width="72dp"
                            android:layout_height="34dp"
                            android:text="@string/mask"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSegment"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="6dp"
                        android:text="@string/segment_person"
                        android:textSize="11sp"
                        android:backgroundTint="#00897B"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnRefine"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="6dp"
                        android:text="@string/refine_mask"
                        android:textSize="11sp"
                        android:backgroundTint="#5E35B1"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- 手动修正工具条：点击"手动修正"后显示 -->
                <LinearLayout
                    android:id="@+id/refineToolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btnErase"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="@string/erase"
                        android:textSize="11sp"
                        android:backgroundTint="#E53935"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnPaint"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="@string/paint"
                        android:textSize="11sp"
                        android:backgroundTint="#43A047"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnClearMask"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="@string/clear_mask"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnDoneMask"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="@string/done"
                        android:textSize="11sp"
                        android:backgroundTint="#00897B"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- 笔刷大小滑动条 -->
                <LinearLayout
                    android:id="@+id/brushSizeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/brush_size"
                        style="@style/PropLabel" />
                    <SeekBar
                        android:id="@+id/seekBrush"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:max="120"
                        android:progress="30" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:background="#EEEEEE" />

                <!-- 组：调整（不透明度 + 锁定） -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="12dp"
                    android:paddingStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/opacity"
                        style="@style/PropLabel" />

                    <SeekBar
                        android:id="@+id/seekOpacity"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="100" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/lock"
                            style="@style/PropLabel" />

                        <ToggleButton
                            android:id="@+id/toggleLock"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:textOn="@string/locked"
                            android:textOff="@string/unlock"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:background="#EEEEEE" />

                <!-- 组：对齐 + 分布 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="12dp"
                    android:paddingStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/align"
                        style="@style/PropSectionTitle" />

                    <GridLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:rowCount="2"
                        android:layout_marginTop="4dp">

                        <Button
                            android:id="@+id/btnAlignLeft"
                            android:layout_width="64dp"
                            android:layout_height="32dp"
                            android:layout_margin="2dp"
                            android:text="@string/align_left"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btnAlignCenterH"
                            android:layout_width="64dp"
                            android:layout_height="32dp"
                            android:layout_margin="2dp"
                            android:text="@string/align_center_h"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btnAlignRight"
                            android:layout_width="64dp"
                            android:layout_height="32dp"
                            android:layout_margin="2dp"
                            android:text="@string/align_right"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btnAlignTop"
                            android:layout_width="64dp"
                            android:layout_height="32dp"
                            android:layout_margin="2dp"
                            android:text="@string/align_top"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btnAlignCenterV"
                            android:layout_width="64dp"
                            android:layout_height="32dp"
                            android:layout_margin="2dp"
                            android:text="@string/align_center_v"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btnAlignBottom"
                            android:layout_width="64dp"
                            android:layout_height="32dp"
                            android:layout_margin="2dp"
                            android:text="@string/align_bottom"
                            android:textSize="10sp" />
                    </GridLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <Button
                            android:id="@+id/btnDistributeH"
                            android:layout_width="96dp"
                            android:layout_height="30dp"
                            android:text="@string/distribute_h"
                            android:textSize="10sp"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnDistributeV"
                            android:layout_width="96dp"
                            android:layout_height="30dp"
                            android:text="@string/distribute_v"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:background="#EEEEEE" />

                <!-- 组：图层 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="12dp"
                    android:paddingStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/layers"
                        style="@style/PropSectionTitle" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <Button
                            android:id="@+id/btnLayerFront"
                            android:layout_width="84dp"
                            android:layout_height="30dp"
                            android:text="@string/layer_front"
                            android:textSize="10sp"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnLayerBack"
                            android:layout_width="84dp"
                            android:layout_height="30dp"
                            android:text="@string/layer_back"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <Button
                            android:id="@+id/btnLayerUp"
                            android:layout_width="84dp"
                            android:layout_height="30dp"
                            android:text="@string/layer_up"
                            android:textSize="10sp"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnLayerDown"
                            android:layout_width="84dp"
                            android:layout_height="30dp"
                            android:text="@string/layer_down"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:background="#EEEEEE" />

                <!-- 组：删除 -->
                <Button
                    android:id="@+id/btnDelete"
                    android:layout_width="72dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:text="@android:string/ok"
                    android:textSize="12sp"
                    android:backgroundTint="#E53935"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 底栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="2dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/add_image"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRandom"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:text="@string/random_layout"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSegmentAll"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:text="@string/segment_all"
            android:textSize="13sp"
            android:backgroundTint="#00897B"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/zoom"
            style="@style/PropLabel" />

        <SeekBar
            android:id="@+id/seekZoom"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="100" />
    </LinearLayout>
</LinearLayout>
